# App
APP_ENV=development
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
REDIS_URL=
STORAGE_DIR=./storage
TEMPLATES_FILE=./config/templates.yaml
PACKAGES_FILE=./config/packages.yaml
FEATURES_FILE=./config/features.yaml

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MODE=polling
TELEGRAM_RETRY_SECONDS=5
ADMIN_IDS=
SUPPORT_CHAT_ID=

# AI provider: mock | openai
IMAGE_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium

# Photo animation: auto | mock | aitunnel
VIDEO_PROVIDER=auto
VIDEO_MODEL=wan-2.7
VIDEO_DURATION_SECONDS=5
VIDEO_SIZE=720x1280
VIDEO_POLL_INTERVAL_SECONDS=15
VIDEO_TIMEOUT_SECONDS=600
VIDEO_GENERATE_AUDIO=false

# Payments: mock | cloudpayments
PAYMENT_PROVIDER=mock
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_API_URL=https://api.cloudpayments.ru
CLOUDPAYMENTS_OFFER_URL=
CLOUDPAYMENTS_SUCCESS_URL=
CLOUDPAYMENTS_FAIL_URL=

# Fiscal receipts. CloudPayments can pass receipt data automatically.
CLOUDKASSIR_ENABLED=false
CLOUDKASSIR_INN=
CLOUDKASSIR_TAXATION_SYSTEM=0
CLOUDKASSIR_VAT=0
CLOUDKASSIR_RECEIPT_OBJECT=4
CLOUDKASSIR_RECEIPT_METHOD=4

# User-facing legal/support links
PRIVACY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms
CONSENT_URL=https://example.com/consent
SUPPORT_URL=

# Configurable business rules
WELCOME_CREDITS=0
WELCOME_BALANCE_RUB=0
GENERATION_CREDITS=1
ADMIN_FREE_GENERATIONS=true
MAX_UPLOAD_MB=20
PHOTO_RETENTION_DAYS=7
RESULT_RETENTION_DAYS=7
DELETE_USER_FILES_ON_REQUEST=true

# Legal/operator details
OPERATOR_NAME=ИП Юрова Людмила Георгиевна
OPERATOR_INN=343609055622
OPERATOR_OGRNIP=326344300036615
# Не публикуем домашний адрес. При необходимости укажите официальный адрес отдельно.
OPERATOR_ADDRESS=
